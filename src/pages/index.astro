---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { SITE, EXPERIENCE, SOCIAL_LINKS } from '../data/site';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter((entry) => entry.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={`${SITE.name} — ${SITE.subtitle}`} description={SITE.description}>
  <section class="border-b border-hairline pb-10 sm:pb-12">
    <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-5xl">
      {SITE.name}
    </h1>
    <p class="mt-2 font-display text-lg italic text-ink-muted sm:text-xl">
      {SITE.subtitle} — {SITE.role}
    </p>
    <p class="mt-5 max-w-[62ch] text-base leading-relaxed text-ink sm:text-lg">
      {SITE.bio}
    </p>

    <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm">
      <a
        href="/projects"
        class="inline-flex min-h-8 items-center rounded-xs border border-hairline-strong bg-surface-elevated px-3.5 py-1.5 font-medium text-ink no-underline transition-colors hover:border-accent hover:text-accent"
      >
        Explore case studies <span aria-hidden="true" class="ml-1.5">→</span>
      </a>
      <a
        href="/about"
        class="inline-flex min-h-8 items-center py-1 font-medium text-ink underline decoration-hairline-strong underline-offset-[0.25em] hover:text-accent hover:decoration-accent"
      >
        Background & hardware work
      </a>
      <a
        href={`mailto:${SITE.email}`}
        class="inline-flex min-h-8 items-center py-1 font-mono text-xs text-ink-muted underline decoration-hairline-strong underline-offset-[0.25em] hover:text-ink hover:decoration-accent sm:text-sm"
      >
        {SITE.email}
      </a>
    </div>
  </section>

  <section class="mt-12 border-b border-hairline pb-12 sm:mt-14 sm:pb-14">
    <div class="flex flex-wrap items-baseline justify-between gap-4">
      <h2 class="font-display text-2xl font-bold text-ink sm:text-3xl">
        Selected Work
      </h2>
      <a
        href="/projects"
        class="group inline-flex min-h-7 items-center text-sm font-medium text-accent no-underline"
      >
        <span class="underline decoration-accent/60 underline-offset-[0.25em] group-hover:decoration-accent">All projects ({allProjects.length})</span> <span aria-hidden="true" class="ml-1">→</span>
      </a>
    </div>
    <p class="mt-2 text-sm text-ink-muted">
      Production web platforms, offline-first mobile systems, and multi-year architectural rebuilds.
    </p>

    <div class="mt-6 grid gap-6">
      {
        featuredProjects.map((project) => (
          <ProjectCard
            slug={project.id}
            data={project.data}
            headingLevel="h3"
          />
        ))
      }
    </div>
  </section>

  <section class="mt-12 border-b border-hairline pb-6 sm:mt-14 sm:pb-8">
    <div class="flex flex-wrap items-baseline justify-between gap-4">
      <h2 class="font-display text-2xl font-bold text-ink sm:text-3xl">
        Hardware & Community
      </h2>
      <a
        href="/about"
        class="group inline-flex min-h-7 items-center text-sm font-medium text-accent no-underline"
      >
        <span class="underline decoration-accent/60 underline-offset-[0.25em] group-hover:decoration-accent">More on About</span> <span aria-hidden="true" class="ml-1">→</span>
      </a>
    </div>
    <p class="mt-2 text-sm text-ink-muted">
      Beyond software repositories—hands-on diagnostics, custom PC builds, and local developer workshops in Dumaguete City.
    </p>

    <ul role="list" class="mt-6 divide-y divide-hairline border-t border-hairline">
      {
        EXPERIENCE.map((item) => (
          <li class="py-4 sm:py-5">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h3 class="font-display text-lg font-bold text-ink">
                {item.organization}
                <span class="font-sans text-sm font-normal text-ink-muted"> · {item.title}</span>
              </h3>
              <span class="font-mono text-xs tabular-nums text-ink-muted">{item.period}</span>
            </div>
            <p class="mt-1.5 max-w-[65ch] text-sm leading-relaxed text-ink-muted">
              {item.summary}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-12 sm:mt-14">
    <h2 class="font-display text-2xl font-bold text-ink sm:text-3xl">
      Get in Touch
    </h2>
    <p class="mt-2 max-w-[58ch] text-sm leading-relaxed text-ink-muted sm:text-base">
      Open to software engineering internships, full-stack collaborations, and technical discussions around web architecture, on-device ML, or custom hardware.
    </p>

    <ul role="list" class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm">
      {
        SOCIAL_LINKS.map((item) => (
          <li>
            <a
              href={item.href}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener noreferrer' : undefined}
              class="group inline-flex min-h-7 items-center font-medium text-ink no-underline hover:text-accent"
            >
              <span class="underline decoration-accent decoration-1 underline-offset-[0.25em]">{item.label}: <span class="ml-1 font-mono text-xs text-ink-muted group-hover:text-accent">{item.handle}</span></span>
              {item.external && (
                <>
                  <span class="visually-hidden"> (opens in a new tab)</span>
                  <span aria-hidden="true" class="ml-1 text-xs">↗</span>
                </>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
