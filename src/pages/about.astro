---
import BaseLayout from '../layouts/BaseLayout.astro';
import TechBadge from '../components/TechBadge.astro';
import { SITE, EXPERIENCE, EDUCATION, TOOLBOX } from '../data/site';
---

<BaseLayout
  title="About"
  description="About Westen Dasig (John Westen Rey Dasig) — Computer Science student at Foundation University Dumaguete, full-stack builder, and founder of WesTech."
>
  <header class="border-b border-hairline pb-8">
    <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">
      About {SITE.name}
    </h1>
    <p class="mt-2 text-base font-medium text-ink-muted sm:text-lg">
      {SITE.role} · {SITE.location}
    </p>
  </header>

  <section class="mt-8 space-y-4 border-b border-hairline pb-10 text-base leading-relaxed text-ink">
    <p class="max-w-[65ch]">
      {SITE.bio}
    </p>
    <p class="max-w-[65ch]">
      On the software side, I like taking early ideas or prototypes and turning them into reliable apps people actually use—like running facial recognition directly on Android devices for offline attendance (<a href="/projects/here/" class="font-medium text-accent underline underline-offset-[0.22em]">Here!</a>), building a commission and order-tracking platform with Laravel and React (<a href="/projects/jb2k-mods/" class="font-medium text-accent underline underline-offset-[0.22em]">JB2K Mods</a>), or developing a dedicated campus election platform (<a href="/projects/susg-voting-system/" class="font-medium text-accent underline underline-offset-[0.22em]">SUSG Voting System</a>).
    </p>
    <p class="max-w-[65ch]">
      Outside of code, I've run <strong>WesTech</strong> in Tanjay City since 2020, where I repair computers and phones and put together custom PC builds. Fixing everyday devices and building desktop PCs keeps my approach to software grounded in making things that are practical, fast, and dependable.
    </p>
  </section>

  <section class="mt-10 border-b border-hairline pb-10">
    <h2 class="font-display text-2xl font-bold text-ink">
      Experience & Community
    </h2>
    <ul role="list" class="mt-6 space-y-4">
      {
        EXPERIENCE.map((item, index) => (
          <li>
            <details
              open={index === 0}
              class="group rounded-sm border border-hairline bg-surface-elevated/40 transition-colors hover:border-hairline-strong"
            >
              <summary class="accordion-summary flex flex-wrap items-start justify-between gap-x-4 gap-y-2 p-5">
                <div class="min-w-0 flex-1">
                  <h3 class="font-display text-lg font-bold text-ink">
                    {item.title} · <span class="text-accent">{item.organization}</span>
                  </h3>
                  <p class="mt-0.5 font-mono text-xs text-ink-muted">{item.location}</p>
                </div>
                <div class="flex shrink-0 items-center gap-2 font-mono text-xs tabular-nums text-ink-muted">
                  <span>{item.period}</span>
                  <svg
                    class="accordion-chevron h-3.5 w-3.5 text-ink-muted transition-colors group-hover:text-ink"
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M4 6l4 4 4-4" />
                  </svg>
                </div>
              </summary>
              <div class="border-t border-hairline/75 px-5 pb-5 pt-4">
                <p class="max-w-[65ch] text-sm leading-relaxed text-ink">
                  {item.summary}
                </p>
                <ul class="mt-3 max-w-[65ch] list-disc space-y-1.5 pl-5 text-sm text-ink-muted">
                  {item.highlights.map((point) => <li>{point}</li>)}
                </ul>
              </div>
            </details>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-10 border-b border-hairline pb-10">
    <h2 class="font-display text-2xl font-bold text-ink">
      Education
    </h2>
    <ul role="list" class="mt-5 space-y-4">
      {
        EDUCATION.map((edu, index) => (
          <li>
            <details
              open={index === 0}
              class="group rounded-sm border border-hairline bg-surface-elevated/40 transition-colors hover:border-hairline-strong"
            >
              <summary class="accordion-summary flex flex-wrap items-start justify-between gap-x-4 gap-y-2 p-5">
                <div class="min-w-0 flex-1">
                  <h3 class="font-display text-lg font-bold text-ink">{edu.institution}</h3>
                  <p class="mt-1 text-sm font-medium text-ink">{edu.degree}</p>
                  <p class="mt-0.5 font-mono text-xs text-ink-muted">{edu.location}</p>
                </div>
                <div class="flex shrink-0 items-center gap-2 font-mono text-xs tabular-nums text-ink-muted">
                  <span>{edu.period}</span>
                  <svg
                    class="accordion-chevron h-3.5 w-3.5 text-ink-muted transition-colors group-hover:text-ink"
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M4 6l4 4 4-4" />
                  </svg>
                </div>
              </summary>
              {(edu.summary || (edu.activities && edu.activities.length > 0)) && (
                <div class="border-t border-hairline/75 px-5 pb-5 pt-4">
                  {edu.summary && (
                    <p class="max-w-[65ch] text-sm leading-relaxed text-ink">
                      {edu.summary}
                    </p>
                  )}
                  {edu.activities && edu.activities.length > 0 && (
                    <div class={edu.summary ? 'mt-3' : undefined}>
                      <p class="font-mono text-xs text-ink-muted">Activities & societies</p>
                      <ul class="mt-1.5 max-w-[65ch] list-disc space-y-1 pl-5 text-sm text-ink-muted">
                        {edu.activities.map((activity) => (
                          <li>{activity}</li>
                        ))}
                      </ul>
                    </div>
                  )}
                </div>
              )}
            </details>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-10">
    <h2 class="font-display text-2xl font-bold text-ink">
      Stack & Tools
    </h2>
    <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2">
      {
        TOOLBOX.map((group) => (
          <div class="rounded-sm border border-hairline p-4 sm:p-5">
            <h3 class="font-display text-base font-bold text-ink">{group.category}</h3>
            <ul role="list" class="mt-3 flex flex-wrap gap-1.5">
              {
                group.items.map((tool) => (
                  <li>
                    <TechBadge name={tool} size="md" />
                  </li>
                ))
              }
            </ul>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
