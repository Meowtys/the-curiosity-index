---
import { SITE } from '../data/site';

export interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const DEFAULT_IMAGE = '/og-default.png';
const DEFAULT_IMAGE_ALT = `${SITE.name} — ${SITE.subtitle}: ${SITE.role}.`;

const {
  title,
  description,
  image,
  imageAlt,
  type = 'website',
  noindex = false,
} = Astro.props;

const fullTitle = title.includes(SITE.name)
  ? title
  : `${title} · ${SITE.name} — ${SITE.subtitle}`;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? SITE.siteUrl);
const resolvedImage = image ?? (noindex ? undefined : DEFAULT_IMAGE);
const socialImageURL = resolvedImage
  ? new URL(resolvedImage, Astro.site ?? SITE.siteUrl).toString()
  : undefined;
const socialImageAlt = image ? imageAlt : DEFAULT_IMAGE_ALT;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="color-scheme" content="light dark" />
<script is:inline>
  try {
    const t = localStorage.getItem('curiosity_theme');
    if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
  } catch {}
</script>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="canonical" href={canonicalURL.toString()} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
/>

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={SITE.name} />
{noindex && <meta name="robots" content="noindex" />}

<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL.toString()} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content={`${SITE.name} — ${SITE.subtitle}`} />
{socialImageURL && <meta property="og:image" content={socialImageURL} />}
{socialImageURL && socialImageAlt && <meta property="og:image:alt" content={socialImageAlt} />}

<meta name="twitter:card" content={socialImageURL ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
{socialImageURL && <meta name="twitter:image" content={socialImageURL} />}
{socialImageURL && socialImageAlt && <meta name="twitter:image:alt" content={socialImageAlt} />}
