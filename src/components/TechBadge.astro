---
export interface Props {
  name: string;
  size?: 'sm' | 'md';
}

const { name, size = 'md' } = Astro.props;
const lower = name.toLowerCase();

type IconKey =
  | 'flutter'
  | 'dart'
  | 'mlkit'
  | 'tflite'
  | 'firebase'
  | 'astro'
  | 'laravel'
  | 'php'
  | 'inertia'
  | 'react'
  | 'typescript'
  | 'javascript'
  | 'tailwind'
  | 'database'
  | 'python'
  | 'wcag'
  | 'cloudflare'
  | 'railway'
  | 'vercel'
  | 'hardware'
  | 'code';

function resolveIcon(label: string): IconKey {
  if (label.includes('flutter')) return 'flutter';
  if (label.includes('dart')) return 'dart';
  if (label.includes('ml kit')) return 'mlkit';
  if (label.includes('tensorflow') || label.includes('tflite')) return 'tflite';
  if (label.includes('firebase')) return 'firebase';
  if (label.includes('astro')) return 'astro';
  if (label.includes('laravel')) return 'laravel';
  if (label.includes('php') || label.includes('larastan')) return 'php';
  if (label.includes('inertia')) return 'inertia';
  if (label.includes('react')) return 'react';
  if (label.includes('typescript')) return 'typescript';
  if (label.includes('javascript') || label.includes('vanilla js')) return 'javascript';
  if (label.includes('tailwind')) return 'tailwind';
  if (label.includes('sqlite') || label.includes('mariadb') || label.includes('mysql')) return 'database';
  if (label.includes('python')) return 'python';
  if (label.includes('wcag') || label.includes('accessibility')) return 'wcag';
  if (label.includes('cloudflare')) return 'cloudflare';
  if (label.includes('railway')) return 'railway';
  if (label.includes('vercel')) return 'vercel';
  if (label.includes('hardware') || label.includes('pc ')) return 'hardware';
  return 'code';
}

const icon = resolveIcon(lower);
const pillClasses =
  size === 'sm'
    ? 'inline-flex items-center gap-1.5 rounded-xs border border-hairline bg-surface px-2 py-1 font-mono text-xs leading-tight text-ink break-words'
    : 'inline-flex items-center gap-1.5 rounded-xs border border-hairline bg-surface-elevated px-2.5 py-1 font-mono text-xs text-ink break-words';
---

<span class={pillClasses}>
  {
    icon === 'flutter' && (
