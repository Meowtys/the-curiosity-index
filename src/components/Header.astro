---
import { SITE, NAV_LINKS } from '../data/site';

// Pages and nav links both end in '/' (trailingSlash: 'always'), so a prefix match covers nested pages.
const pathname = Astro.url.pathname;
const isHome = pathname === '/';

function isActive(href: string): boolean {
  return href === '/' ? pathname === '/' : pathname.startsWith(href);
}
---

<header class="border-b border-hairline">
  <div class="mx-auto flex w-full max-w-[46rem] flex-wrap items-center justify-between gap-x-6 gap-y-3 px-5 py-5 sm:px-8">
    <a
      href="/"
      aria-current={isHome ? 'page' : undefined}
      class="group inline-flex flex-wrap items-center gap-x-2.5 gap-y-0.5 py-1 text-ink no-underline"
    >
      <span class="inline-flex h-6 w-6 items-center justify-center rounded-xs border border-hairline-strong bg-surface-elevated font-mono text-xs font-semibold text-ink transition-colors group-hover:border-accent group-hover:text-accent">WD</span>
      {
        isHome ? (
          <span class="font-display text-base font-semibold tracking-tight text-ink group-hover:text-accent">
            {SITE.subtitle}
          </span>
        ) : (
          <>
            <span class="font-display text-base font-semibold tracking-tight text-ink group-hover:text-accent">
              {SITE.name}
            </span>
            <span class="text-sm text-ink-muted">
              {SITE.subtitle}
            </span>
          </>
        )
      }
    </a>

    <div class="flex items-center gap-4">
      <nav aria-label="Primary">
        <ul role="list" class="flex flex-wrap items-center gap-x-5 gap-y-1 text-sm">
          {
            NAV_LINKS.map((link) => {
              const active = isActive(link.href);
              return (
                <li>
                  <a
                    href={link.href}
                    aria-current={active ? 'page' : undefined}
                    class:list={[
                      'tap-target inline-flex min-h-7 items-center py-1 transition-colors',
                      active
                        ? 'font-semibold text-ink underline decoration-accent decoration-2 underline-offset-[0.35em]'
                        : 'text-ink-muted decoration-hairline-strong underline-offset-[0.35em] hover:text-ink hover:underline',
                    ]}
                  >
                    {link.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>

      <button
        id="theme-toggle"
        type="button"
        role="switch"
        aria-checked="false"
        aria-label="Toggle color theme"
        title="Toggle color theme"
        class="tap-target inline-flex h-8 w-8 shrink-0 cursor-pointer items-center justify-center rounded-full border border-hairline bg-surface-elevated text-ink-muted transition-colors hover:border-hairline-strong hover:text-ink"
      >
        <svg
          class="theme-icon-sun h-4 w-4"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="8" cy="8" r="2.8" />
          <path d="M8 1.5v1.6M8 12.9v1.6M1.5 8h1.6M12.9 8h1.6M3.4 3.4l1.1 1.1M11.5 11.5l1.1 1.1M12.6 3.4l-1.1 1.1M4.5 11.5l-1.1 1.1" />
        </svg>
        <svg
          class="theme-icon-moon h-3.5 w-3.5"
          viewBox="0 0 16 16"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M14.2 10.6a6.5 6.5 0 0 1-8.8-8.8A6.7 6.7 0 1 0 14.2 10.6z" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const themeBtn = document.getElementById('theme-toggle') as HTMLButtonElement | null;
  if (themeBtn) {
    const STORAGE_KEY = 'curiosity_theme';
    const themeQuery = window.matchMedia('(prefers-color-scheme: dark)');

    function getActiveTheme(): 'dark' | 'light' {
      const explicit = document.documentElement.dataset.theme;
      if (explicit === 'dark' || explicit === 'light') return explicit;
      return themeQuery.matches ? 'dark' : 'light';
    }

    function syncButton() {
      const isDark = getActiveTheme() === 'dark';
      const nextLabel = isDark ? 'Switch to light mode' : 'Switch to dark mode';
      themeBtn!.setAttribute('aria-checked', String(isDark));
      themeBtn!.setAttribute('aria-label', nextLabel);
      themeBtn!.setAttribute('title', nextLabel);
    }

    themeBtn.addEventListener('click', () => {
      const next = getActiveTheme() === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try {
        window.localStorage.setItem(STORAGE_KEY, next);
      } catch {
        // Ignore storage restrictions in private browsing.
      }
      syncButton();
    });

    themeQuery.addEventListener('change', syncButton);
    syncButton();
  }
</script>
