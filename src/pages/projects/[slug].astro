---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TechBadge from '../../components/TechBadge.astro';
import { getStatusBadgeClass } from '../../data/site';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort(
    (a, b) => a.data.order - b.data.order,
  );

  return projects.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: index > 0 ? projects[index - 1] : undefined,
      next: index < projects.length - 1 ? projects[index + 1] : undefined,
    },
  }));
}

export interface Props {
  entry: CollectionEntry<'projects'>;
  prev?: CollectionEntry<'projects'>;
  next?: CollectionEntry<'projects'>;
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;

const badgeClass = getStatusBadgeClass(data.status);

// Shown when a project has no public URL; worded from its status so archived or private-live work isn't mislabeled.
const NO_URL_LABELS: Record<typeof data.status, string> = {
  Live: 'Private deployment',
  'Open Beta': 'Private beta · Access on request',
  'In Development': 'Private deployment · In development',
  Archived: 'No longer deployed',
};
---

<BaseLayout
  title={`${data.title} — Case Study`}
  description={data.description}
  image={data.cover?.src}
  imageAlt={data.coverAlt}
  type="article"
>
  <nav aria-label="Breadcrumb" class="mb-6">
    <a
      href="/projects/"
      class="tap-target group inline-flex min-h-7 items-center text-sm font-medium text-ink-muted no-underline transition-colors hover:text-ink"
    >
      <span aria-hidden="true" class="mr-1.5">←</span>
      <span class="underline decoration-hairline-strong underline-offset-[0.25em] group-hover:decoration-accent">All projects</span>
    </a>
  </nav>

  <header class="border-b border-hairline pb-8">
    <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">
      {data.title}
    </h1>
    <p class="mt-2 text-base font-medium text-ink-muted sm:text-lg">
      {data.subtitle}
    </p>

    <div class="mt-4 flex flex-wrap items-center gap-2.5 text-xs text-ink-muted">
      <span class={badgeClass}>{data.status}</span>
      <span aria-hidden="true">·</span>
      <span class="font-mono tabular-nums">{data.timeline}</span>
      <span aria-hidden="true">·</span>
      <span class="font-mono">{data.category}</span>
    </div>

    {
      data.cover && (
        <figure class="mt-6 overflow-hidden rounded-sm border border-hairline">
          <button
            type="button"
            class="lightbox-trigger group block w-full text-left cursor-zoom-in focus-visible:outline-accent"
            aria-label={`Enlarge cover image: ${data.coverAlt ?? data.title}`}
            data-full-src={data.cover.src}
            data-caption={`${data.title} — ${data.subtitle}`}
          >
            <Image
              src={data.cover}
              alt={data.coverAlt ?? `${data.title} interface preview`}
              widths={[736, 1472]}
              sizes="(min-width: 46rem) 42rem, calc(100vw - 2.5rem)"
              loading="eager"
              fetchpriority="high"
              class="h-auto w-full transition-transform duration-200 group-hover:scale-[1.01]"
            />
          </button>
        </figure>
      )
    }

    <dl class="mt-6 grid grid-cols-1 gap-4 rounded-sm border border-hairline bg-surface-elevated/45 p-4 text-sm sm:grid-cols-2 sm:p-5">
      <div>
        <dt class="font-mono text-xs text-ink-muted">Role</dt>
        <dd class="mt-0.5 font-medium text-ink">{data.role}</dd>
      </div>
      <div>
        <dt class="font-mono text-xs text-ink-muted">Timeline</dt>
        <dd class="mt-0.5 font-mono text-xs tabular-nums text-ink sm:text-sm">{data.timeline}</dd>
      </div>
      <div>
        <dt class="font-mono text-xs text-ink-muted">Deployment & Access</dt>
        <dd class="mt-0.5">
          {
            data.liveUrl ? (
              <a
                href={data.liveUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="group inline-flex items-center font-medium text-accent no-underline break-all"
              >
                <span class="underline decoration-accent/70 underline-offset-[0.22em] group-hover:decoration-accent">{data.liveUrl.replace(/^https?:\/\//, '')}</span>
                <span class="visually-hidden"> (opens in a new tab)</span>
                <span aria-hidden="true" class="ml-1 text-xs">↗</span>
              </a>
            ) : (
              <span class="text-ink-muted">{NO_URL_LABELS[data.status]}</span>
            )
          }
        </dd>
      </div>
      <div>
        <dt class="font-mono text-xs text-ink-muted">Source Repository</dt>
        <dd class="mt-0.5 text-ink-muted">
          {
            data.repoUrl ? (
              <a
                href={data.repoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="font-medium text-accent underline underline-offset-[0.22em]"
              >
                Public repository <span aria-hidden="true">↗</span>
              </a>
            ) : (
              <span>Private repository (architecture documented below)</span>
            )
          }
        </dd>
      </div>
      <div class="sm:col-span-2">
        <dt class="font-mono text-xs text-ink-muted">Technical Stack</dt>
        <dd class="mt-1.5">
          <ul role="list" class="flex flex-wrap gap-1.5" aria-label="Technical stack">
            {
              data.tags.map((tag) => (
                <li>
                  <TechBadge name={tag} size="sm" />
                </li>
              ))
            }
          </ul>
        </dd>
      </div>
    </dl>
  </header>

  <article class="prose prose-editorial mt-8 sm:mt-10">
    <Content />
  </article>

  {
    data.gallery && (
      <section aria-labelledby="screens-heading" class="mt-12 border-t border-hairline pt-8">
        <h2 id="screens-heading" class="font-display text-2xl font-bold tracking-tight text-ink">
          Screens
        </h2>
        <div class="mt-6 grid grid-cols-6 gap-x-4 gap-y-8">
          {data.gallery.map((shot) => {
            // Landscape shots get the full column; phone shots sit three to a row (two on small screens).
            const wide = shot.src.width > shot.src.height;
            return (
              <figure class={wide ? 'col-span-6' : 'col-span-3 sm:col-span-2'}>
                <button
                  type="button"
                  class="lightbox-trigger group block w-full text-left cursor-zoom-in rounded-sm overflow-hidden focus-visible:outline-accent"
                  aria-label={`Enlarge image: ${shot.alt}`}
                  data-full-src={shot.src.src}
                  data-caption={shot.caption}
                >
                  <Image
                    src={shot.src}
                    alt={shot.alt}
                    widths={wide ? [736, 1472] : [240, 480, 720]}
                    sizes={wide ? '(min-width: 46rem) 42rem, calc(100vw - 2.5rem)' : '(min-width: 40rem) 14rem, 45vw'}
                    class="h-auto w-full rounded-sm border border-hairline transition-transform duration-200 group-hover:scale-[1.01]"
                  />
                </button>
                <figcaption class="mt-2 max-w-[65ch] text-sm text-ink-muted">{shot.caption}</figcaption>
              </figure>
            );
          })}
        </div>
      </section>
    )
  }

  <nav
    aria-label="Case study pagination"
    class="mt-12 grid grid-cols-1 gap-4 border-t border-hairline pt-8 sm:grid-cols-2"
  >
    <div>
      {
        prev && (
          <a
            href={`/projects/${prev.id}/`}
            class="group block rounded-sm border border-hairline p-4 no-underline transition-colors hover:border-hairline-strong"
          >
            <span class="block font-mono text-xs text-ink-muted">← Previous project</span>
            <span class="mt-1 block font-display text-lg font-bold text-ink group-hover:text-accent">
              {prev.data.title}
            </span>
          </a>
        )
      }
    </div>
    <div class="sm:text-right">
      {
        next && (
          <a
            href={`/projects/${next.id}/`}
            class="group block rounded-sm border border-hairline p-4 no-underline transition-colors hover:border-hairline-strong"
          >
            <span class="block font-mono text-xs text-ink-muted">Next project →</span>
            <span class="mt-1 block font-display text-lg font-bold text-ink group-hover:text-accent">
              {next.data.title}
            </span>
          </a>
        )
      }
    </div>
  </nav>

  <dialog
    id="image-lightbox"
    class="backdrop:bg-black/85 backdrop:backdrop-blur-xs fixed inset-0 m-auto max-h-[92vh] max-w-[94vw] bg-transparent p-0 border-0 overflow-visible text-white focus:outline-none"
    aria-label="Enlarged screenshot preview"
  >
    <div class="relative flex flex-col items-center">
      <div class="mb-2 flex w-full items-center justify-between gap-4 text-xs font-mono text-zinc-300">
        <span id="lightbox-caption" class="truncate"></span>
        <button
          type="button"
          id="lightbox-close"
          class="tap-target inline-flex items-center rounded-xs border border-zinc-700 bg-zinc-900/90 px-2.5 py-1 text-zinc-200 hover:border-zinc-500 hover:text-white cursor-pointer"
          aria-label="Close enlarged preview"
        >
          Close [Esc]
        </button>
      </div>
      <img
        id="lightbox-img"
        src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1 1'%3E%3C/svg%3E"
        alt=""
        class="max-h-[82vh] max-w-full rounded-sm border border-zinc-800 object-contain shadow-2xl"
      />
    </div>
  </dialog>

  <script>
    const dialog = document.getElementById('image-lightbox') as HTMLDialogElement | null;
    const closeBtn = document.getElementById('lightbox-close');
    const img = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const caption = document.getElementById('lightbox-caption');
    const triggers = document.querySelectorAll<HTMLButtonElement>('.lightbox-trigger');

    if (dialog && closeBtn && img && caption && triggers.length > 0) {
      let activeTrigger: HTMLButtonElement | null = null;

      function openLightbox(trigger: HTMLButtonElement) {
        activeTrigger = trigger;
        const fullSrc = trigger.getAttribute('data-full-src');
        const alt = trigger.getAttribute('aria-label') || '';
        const cap = trigger.getAttribute('data-caption') || '';

        if (fullSrc) {
          img!.src = fullSrc;
          img!.alt = alt;
          caption!.textContent = cap;
          dialog!.showModal();
        }
      }

      function closeLightbox() {
        if (dialog!.open) {
          dialog!.close();
          img!.src = '';
          if (activeTrigger) {
            activeTrigger.focus();
            activeTrigger = null;
          }
        }
      }

      triggers.forEach((btn) => {
        btn.addEventListener('click', () => openLightbox(btn));
      });

      closeBtn.addEventListener('click', closeLightbox);

      dialog.addEventListener('click', (e) => {
        const rect = dialog.getBoundingClientRect();
        const isInDialog = (
          rect.top <= e.clientY &&
          e.clientY <= rect.top + rect.height &&
          rect.left <= e.clientX &&
          e.clientX <= rect.left + rect.width
        );
        if (!isInDialog) {
          closeLightbox();
        }
      });

      dialog.addEventListener('close', () => {
        img!.src = '';
      });
    }
  </script>
</BaseLayout>
