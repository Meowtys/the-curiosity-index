---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, SOCIAL_LINKS } from '../data/site';
---

<BaseLayout
  title="Contact"
  description="Direct contact links for Westen Dasig — email, LinkedIn, and GitHub."
>
  <header class="border-b border-hairline pb-8">
    <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">
      Contact
    </h1>
    <p class="mt-3 max-w-[60ch] text-base leading-relaxed text-ink-muted">
      Whether you want to discuss a full-stack project, software internship, campus system, or custom hardware build in Dumaguete City, the fastest way to reach me is directly by email or LinkedIn.
    </p>
  </header>

  <section class="mt-8" aria-label="Direct contact channels">
    <dl class="divide-y divide-hairline border-y border-hairline">
      {
        SOCIAL_LINKS.map((item) => (
          <div class="flex flex-col justify-between gap-2 py-5 sm:flex-row sm:items-baseline">
            <dt class="font-display text-lg font-bold text-ink">{item.label}</dt>
            <dd>
              <a
                href={item.href}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
                class="inline-flex min-h-7 items-center font-mono text-sm text-accent underline decoration-accent/70 underline-offset-[0.25em] hover:decoration-accent break-all"
              >
                {item.handle}
                {item.external && (
                  <>
                    <span class="visually-hidden"> (opens in a new tab)</span>
                    <span aria-hidden="true" class="ml-1 text-xs">↗</span>
                  </>
                )}
              </a>
            </dd>
          </div>
        ))
      }
      <div class="flex flex-col justify-between gap-2 py-5 sm:flex-row sm:items-baseline">
        <dt class="font-display text-lg font-bold text-ink">Location</dt>
        <dd class="font-mono text-sm text-ink-muted">{SITE.location}</dd>
      </div>
    </dl>
  </section>
</BaseLayout>
