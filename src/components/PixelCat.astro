---
---

<button
  id="cat-toggle"
  type="button"
  aria-pressed="true"
  aria-label="Toggle corner pixel cat"
  class="tap-target fixed top-4 left-4 z-40 hidden w-fit items-center rounded-xs border border-hairline bg-surface-elevated/80 px-2.5 py-1 font-mono text-xs text-ink-muted transition-colors hover:border-hairline-strong hover:text-ink lg:inline-flex"
>
  cat: on
</button>

<span
  id="cat-purr-label"
  aria-hidden="true"
  class="pointer-events-none fixed z-40 hidden font-mono text-xs font-medium text-accent select-none"
>purr~</span>

<canvas
  id="meowtys-cat"
  width="32"
  height="32"
  aria-hidden="true"
  class="pointer-events-none fixed z-40 hidden h-8 w-8 lg:block"
  style="image-rendering: pixelated; left: 18px; top: 58px;"
></canvas>

<script>
  const catCanvas = document.getElementById('meowtys-cat') as HTMLCanvasElement | null;
  const purrLabel = document.getElementById('cat-purr-label') as HTMLSpanElement | null;
  const toggleBtn = document.getElementById('cat-toggle') as HTMLButtonElement | null;

  if (catCanvas && toggleBtn) {
    const ctx = catCanvas.getContext('2d');
    const desktopQuery = window.matchMedia('(min-width: 1024px)');
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const STORAGE_KEY = 'curiosity_cat_disabled';

    let disabled = false;
    try {
      disabled = window.localStorage.getItem(STORAGE_KEY) === 'true';
    } catch {
      disabled = false;
    }

    let x = 18;
    let y = 58;
    let targetX = 18;
    let targetY = 58;
    let frame = 0;
    let idleTicks = 0;
    let alertTicks = 0;
    let purrTicks = 0;
    let facing = 1;
    let state: 'sit' | 'alert' | 'run' | 'sleep' | 'purr' = 'sit';
    let lastTick = 0;
    let rafId = 0;
    let audioCtx: AudioContext | null = null;

    async function playPurrSound() {
      try {
        const AudioCtor =
          window.AudioContext ||
          (window as unknown as { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
        if (!AudioCtor) return;
        audioCtx ??= new AudioCtor();
        if (audioCtx.state === 'suspended') {
          await audioCtx.resume();
        }

        const now = audioCtx.currentTime;
        const duration = 1.15;

        // Filtered throat-noise bed + audible low-mid harmonics modulated at 26Hz so small speakers reproduce the purr trill clearly.
        const bufferSize = Math.floor(audioCtx.sampleRate * duration);
        const noiseBuffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
        const data = noiseBuffer.getChannelData(0);
        let smooth = 0;
        for (let i = 0; i < bufferSize; i++) {
          smooth = smooth * 0.85 + (Math.random() * 2 - 1) * 0.15;
          data[i] = smooth * 2.4;
        }

        const noise = audioCtx.createBufferSource();
        noise.buffer = noiseBuffer;

        const bodyOsc = audioCtx.createOscillator();
        bodyOsc.type = 'sawtooth';
        bodyOsc.frequency.setValueAtTime(118, now);

        const subOsc = audioCtx.createOscillator();
        subOsc.type = 'triangle';
        subOsc.frequency.setValueAtTime(78, now);

        const filter = audioCtx.createBiquadFilter();
        filter.type = 'bandpass';
        filter.frequency.setValueAtTime(220, now);
        filter.Q.setValueAtTime(1.15, now);

        const trillLfo = audioCtx.createOscillator();
        trillLfo.type = 'sine';
        trillLfo.frequency.setValueAtTime(26, now);
        const trillDepth = audioCtx.createGain();
        trillDepth.gain.setValueAtTime(0.14, now);

        const amp = audioCtx.createGain();
        amp.gain.setValueAtTime(0.001, now);
        amp.gain.linearRampToValueAtTime(0.24, now + 0.08);
        amp.gain.setValueAtTime(0.2, now + 0.48);
        amp.gain.linearRampToValueAtTime(0.24, now + 0.65);
        amp.gain.exponentialRampToValueAtTime(0.0001, now + duration);

        const bodyGain = audioCtx.createGain();
        bodyGain.gain.setValueAtTime(0.28, now);
        const subGain = audioCtx.createGain();
        subGain.gain.setValueAtTime(0.32, now);

        trillLfo.connect(trillDepth);
        trillDepth.connect(amp.gain);
        noise.connect(filter);
        bodyOsc.connect(bodyGain);
        bodyGain.connect(filter);
        subOsc.connect(subGain);
        subGain.connect(filter);
        filter.connect(amp);
        amp.connect(audioCtx.destination);

        noise.start(now);
        bodyOsc.start(now);
        subOsc.start(now);
        trillLfo.start(now);

        noise.stop(now + duration);
        bodyOsc.stop(now + duration);
        subOsc.stop(now + duration);
        trillLfo.stop(now + duration);
      } catch {
        // Visual purr still runs even if Web Audio is unavailable.
      }
    }

    function isActive(): boolean {
      return desktopQuery.matches && !motionQuery.matches && !disabled;
    }

    function syncVisibility() {
      const active = isActive();
      catCanvas!.classList.toggle('lg:block', active);
      catCanvas!.classList.toggle('hidden', !active);
      if (!active) purrLabel?.classList.add('hidden');
      toggleBtn!.setAttribute('aria-pressed', String(!disabled));
      toggleBtn!.textContent = disabled || motionQuery.matches ? 'cat: off' : 'cat: on';

      if (active) {
        startLoop();
      } else {
        cancelAnimationFrame(rafId);
        rafId = 0;
      }
    }

    function drawCat() {
      if (!ctx) return;
      ctx.clearRect(0, 0, 32, 32);

      const styles = getComputedStyle(document.documentElement);
      const fur = styles.getPropertyValue('--fg').trim() || '#F3F1EC';
      const eye = styles.getPropertyValue('--bg').trim() || '#111110';
      const accent = styles.getPropertyValue('--accent').trim() || '#FB923C';
      const scale = 2;

      const px = (gx: number, gy: number, w = 1, h = 1, color = fur) => {
        ctx.fillStyle = color;
        const dx = facing < 0 ? (16 - gx - w) * scale : gx * scale;
        ctx.fillRect(dx, gy * scale, w * scale, h * scale);
      };

      if (state === 'sleep') {
        px(4, 10, 8, 4, fur);
        px(5, 9, 4, 2, fur);
        px(5, 8, 1, 1, fur);
        px(8, 8, 1, 1, fur);
        px(4, 11, 8, 1, accent);
        const bob = frame % 2;
        ctx.fillStyle = accent;
        ctx.font = 'bold 9px monospace';
        ctx.fillText(bob === 0 ? 'z' : 'Z', 21, 12 - bob * 2);
        return;
      }

      // Perked ears with inner accent
      px(5, 3, 2, 2, fur);
      px(10, 3, 2, 2, fur);
      px(6, 4, 1, 1, accent);
      px(10, 4, 1, 1, accent);

      // Head & eyes (blinks when sitting, rosy cheeks & soft squint when purring)
      const purrVib = state === 'purr' ? frame % 2 : 0;
      px(5, 5, 7, 4, fur);
      const blinking = state === 'sit' && frame % 26 === 0;
      if (state === 'purr') {
        px(6, 6, 1, 1, eye);
        px(10, 6, 1, 1, eye);
        px(5, 7, 1, 1, accent);
        px(11, 7, 1, 1, accent);
      } else if (!blinking) {
        px(6, 6, 1, state === 'alert' ? 2 : 1, eye);
        px(10, 6, 1, state === 'alert' ? 2 : 1, eye);
      }
      px(8, 7, 1, 1, accent);

      // Accent collar
      px(5, 9, 6, 1, accent);

      // Body & stride paws
      px(3, 10, 8 + purrVib, 4, fur);
      const stride = state === 'run' ? (frame % 2 === 0 ? 1 : -1) : 0;
      px(4 + stride, 14, 2, 1, fur);
      px(9 - stride, 14, 2, 1, fur);

      // Tail flick
      const tailShift = state === 'run' || state === 'purr' || frame % 12 < 3 ? frame % 2 : 0;
      px(2, 9 - tailShift, 1, 3, fur);
      px(1, 8 - tailShift, 1, 2, accent);

      if (state === 'alert') {
        ctx.fillStyle = accent;
        ctx.font = 'bold 9px monospace';
        ctx.fillText('!', 15, 7);
      } else if (state === 'purr') {
        const hy = frame % 2 === 0 ? 1 : 0;
        px(12, hy, 1, 1, accent);
        px(14, hy, 1, 1, accent);
        px(12, hy + 1, 3, 1, accent);
        px(13, hy + 2, 1, 1, accent);
      }
    }

    function step(now: number) {
      if (!isActive() || document.hidden) {
        rafId = 0;
        return;
      }

      if (now - lastTick >= 100) {
        lastTick = now;
        frame++;

        const dx = targetX - x;
        const dy = targetY - y;
        const dist = Math.hypot(dx, dy);

        if (purrTicks > 0) {
          purrTicks--;
          idleTicks = 0;
          state = 'purr';
        } else if (dist > 32) {
          if (state === 'sleep') {
            alertTicks = 3;
          }
          idleTicks = 0;
          if (alertTicks > 0) {
            state = 'alert';
            alertTicks--;
          } else {
            state = 'run';
            if (Math.abs(dx) > 2) facing = dx > 0 ? 1 : -1;
            const move = Math.min(9, dist);
            const rawX = x + (dx / dist) * move;
            const rawY = y + (dy / dist) * move;
            x = Math.max(8, Math.min(window.innerWidth - 40, rawX));
            y = Math.max(8, Math.min(window.innerHeight - 40, rawY));
          }
        } else {
          idleTicks++;
          state = idleTicks > 28 ? 'sleep' : 'sit';
        }

        catCanvas!.style.left = `${Math.round(x)}px`;
        catCanvas!.style.top = `${Math.round(y)}px`;
        if (purrLabel) {
          const showPurr = state === 'purr' && isActive();
          purrLabel.classList.toggle('hidden', !showPurr);
          if (showPurr) {
            purrLabel.style.left = `${Math.round(Math.max(8, Math.min(window.innerWidth - 52, x - 4)))}px`;
            purrLabel.style.top = `${Math.round(Math.max(8, y - 16 - (frame % 2)))}px`;
          }
        }
        drawCat();
      }

      rafId = requestAnimationFrame(step);
    }

    function startLoop() {
      if (!rafId && isActive() && !document.hidden) {
        lastTick = performance.now();
        drawCat();
        rafId = requestAnimationFrame(step);
      }
    }

    window.addEventListener('pointermove', (e) => {
      if (!isActive()) return;
      targetX = e.clientX - 16;
      targetY = e.clientY - 16;
    }, { passive: true });

    window.addEventListener('pointerdown', (e) => {
      if (!isActive()) return;
      const target = e.target as Element | null;
      if (target?.closest('a, button, input, select, textarea, summary, [role="switch"]')) return;
      if (Math.hypot(e.clientX - (x + 16), e.clientY - (y + 16)) <= 30) {
        purrTicks = 18;
        idleTicks = 0;
        state = 'purr';
        if (purrLabel) {
          purrLabel.classList.remove('hidden');
          purrLabel.style.left = `${Math.round(Math.max(8, Math.min(window.innerWidth - 52, x - 4)))}px`;
          purrLabel.style.top = `${Math.round(Math.max(8, y - 16))}px`;
        }
        drawCat();
        void playPurrSound();
      }
    }, { passive: true });

    toggleBtn.addEventListener('click', () => {
      disabled = !disabled;
      try {
        window.localStorage.setItem(STORAGE_KEY, String(disabled));
      } catch {
        // Ignore storage restriction errors in private browsing.
      }
      syncVisibility();
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        cancelAnimationFrame(rafId);
        rafId = 0;
      } else {
        startLoop();
      }
    });

    desktopQuery.addEventListener('change', syncVisibility);
    motionQuery.addEventListener('change', syncVisibility);
    new MutationObserver(() => {
      if (isActive()) drawCat();
    }).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });
    syncVisibility();
  }
</script>
