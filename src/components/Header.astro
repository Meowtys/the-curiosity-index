---
import { SITE, NAV_LINKS } from '../data/site';

// Pages and nav links both end in '/' (trailingSlash: 'always'), so a prefix match covers nested pages.
const pathname = Astro.url.pathname;
const isHome = pathname === '/';

function isActive(href: string): boolean {
  return href === '/' ? pathname === '/' : pathname.startsWith(href);
}
---

<header class="border-b border-hairline bg-surface">
  <div class="mx-auto flex w-full max-w-[46rem] flex-wrap items-center justify-between gap-x-6 gap-y-3 px-5 py-5 sm:px-8">
    <a
      href="/"
      class="group inline-flex flex-wrap items-center gap-x-2.5 gap-y-0.5 py-1 text-ink no-underline"
    >
      <span class="inline-flex h-6 w-6 items-center justify-center rounded-xs border border-hairline-strong bg-surface-elevated font-mono text-xs font-semibold text-ink transition-colors group-hover:border-accent group-hover:text-accent">WD</span>
      {
        isHome ? (
          <span class="font-display text-base font-semibold tracking-tight text-ink group-hover:text-accent">
            {SITE.subtitle}
          </span>
        ) : (
          <>
            <span class="font-display text-base font-semibold tracking-tight text-ink group-hover:text-accent">
              {SITE.name}
            </span>
            <span class="text-sm text-ink-muted">
              {SITE.subtitle}
            </span>
          </>
        )
      }
    </a>

    <nav aria-label="Primary">
      <ul class="flex flex-wrap items-center gap-x-5 gap-y-1 text-sm">
        {
          NAV_LINKS.map((link) => {
            const active = isActive(link.href);
            return (
              <li>
                <a
                  href={link.href}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'inline-flex min-h-7 items-center py-1 transition-colors',
                    active
                      ? 'font-semibold text-ink underline decoration-accent decoration-2 underline-offset-[0.35em]'
                      : 'text-ink-muted hover:text-ink',
                  ]}
                >
                  {link.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>
