---
---

<button
  id="cat-toggle"
  type="button"
  aria-pressed="true"
  aria-label="Toggle corner pixel cat"
  class="tap-target fixed top-4 left-4 z-40 hidden w-fit items-center rounded-xs border border-hairline bg-surface-elevated/80 px-2.5 py-1 font-mono text-xs text-ink-muted transition-colors hover:border-hairline-strong hover:text-ink lg:inline-flex"
>
  cat: on
</button>

<span
  id="cat-meow-label"
  aria-hidden="true"
  class="pointer-events-none fixed z-40 hidden font-mono text-xs font-medium text-accent select-none"
>meow~</span>

<canvas
  id="meowtys-cat"
  width="32"
  height="32"
  aria-hidden="true"
  class="pointer-events-none fixed z-40 hidden h-8 w-8 lg:block"
  style="image-rendering: pixelated; left: 18px; top: 58px;"
></canvas>

<script>
  const catCanvas = document.getElementById('meowtys-cat') as HTMLCanvasElement | null;
  const meowLabel = document.getElementById('cat-meow-label') as HTMLSpanElement | null;
  const toggleBtn = document.getElementById('cat-toggle') as HTMLButtonElement | null;

  if (catCanvas && toggleBtn) {
    const ctx = catCanvas.getContext('2d');
    const desktopQuery = window.matchMedia('(min-width: 1024px)');
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const STORAGE_KEY = 'curiosity_cat_disabled';
    const MEOW_COOLDOWN_MS = 1400;

    let disabled = false;
    try {
      disabled = window.localStorage.getItem(STORAGE_KEY) === 'true';
    } catch {
      disabled = false;
    }

    let x = 18;
    let y = 58;
    let targetX = 18;
    let targetY = 58;
    let frame = 0;
    let idleTicks = 0;
    let alertTicks = 0;
    let meowTicks = 0;
    let lastMeowAt = 0;
    let facing = 1;
    let state: 'sit' | 'alert' | 'run' | 'sleep' | 'meow' = 'sit';
    let lastTick = 0;
    let rafId = 0;
    let audioCtx: AudioContext | null = null;

    async function playMeowSound() {
      try {
        const AudioCtor =
          window.AudioContext ||
          (window as unknown as { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
        if (!AudioCtor) return;
        audioCtx ??= new AudioCtor();
        if (audioCtx.state === 'suspended') {
          await audioCtx.resume();
        }

        const now = audioCtx.currentTime;
        const duration = 0.42;

        const lead = audioCtx.createOscillator();
        const overtone = audioCtx.createOscillator();
        const filter = audioCtx.createBiquadFilter();
        const amp = audioCtx.createGain();
        const overtoneGain = audioCtx.createGain();

        // Expressive meow contour: quick pitch rise then smooth downward glide.
        lead.type = 'triangle';
        lead.frequency.setValueAtTime(520, now);
        lead.frequency.exponentialRampToValueAtTime(790, now + 0.09);
        lead.frequency.exponentialRampToValueAtTime(430, now + duration);

        overtone.type = 'sawtooth';
        overtone.frequency.setValueAtTime(1040, now);
        overtone.frequency.exponentialRampToValueAtTime(1580, now + 0.09);
        overtone.frequency.exponentialRampToValueAtTime(860, now + duration);
        overtoneGain.gain.setValueAtTime(0.18, now);

        filter.type = 'lowpass';
        filter.Q.setValueAtTime(2.6, now);
        filter.frequency.setValueAtTime(1500, now);
        filter.frequency.exponentialRampToValueAtTime(2400, now + 0.1);
        filter.frequency.exponentialRampToValueAtTime(880, now + duration);

        amp.gain.setValueAtTime(0.001, now);
        amp.gain.exponentialRampToValueAtTime(0.18, now + 0.035);
        amp.gain.setValueAtTime(0.16, now + 0.16);
        amp.gain.exponentialRampToValueAtTime(0.0001, now + duration);

        lead.connect(filter);
        overtone.connect(overtoneGain);
        overtoneGain.connect(filter);
        filter.connect(amp);
        amp.connect(audioCtx.destination);

        lead.start(now);
        overtone.start(now);
        lead.stop(now + duration + 0.02);
        overtone.stop(now + duration + 0.02);
      } catch {
        // Visual meow still runs cleanly if Web Audio is unavailable.
      }
    }

    function isActive(): boolean {
      return desktopQuery.matches && !motionQuery.matches && !disabled;
    }

    function syncVisibility() {
      const active = isActive();
      catCanvas!.classList.toggle('lg:block', active);
      catCanvas!.classList.toggle('hidden', !active);
      if (!active) meowLabel?.classList.add('hidden');
      toggleBtn!.setAttribute('aria-pressed', String(!disabled));
      toggleBtn!.textContent = disabled || motionQuery.matches ? 'cat: off' : 'cat: on';

      if (active) {
        startLoop();
      } else {
        cancelAnimationFrame(rafId);
        rafId = 0;
      }
    }

    function drawCat() {
      if (!ctx) return;
      ctx.clearRect(0, 0, 32, 32);

      const styles = getComputedStyle(document.documentElement);
      const fur = styles.getPropertyValue('--fg').trim() || '#F3F1EC';
      const eye = styles.getPropertyValue('--bg').trim() || '#111110';
      const accent = styles.getPropertyValue('--accent').trim() || '#FB923C';
      const scale = 2;

      const px = (gx: number, gy: number, w = 1, h = 1, color = fur) => {
        ctx.fillStyle = color;
        const dx = facing < 0 ? (16 - gx - w) * scale : gx * scale;
        ctx.fillRect(dx, gy * scale, w * scale, h * scale);
      };

      if (state === 'sleep') {
        px(4, 10, 8, 4, fur);
        px(5, 9, 4, 2, fur);
        px(5, 8, 1, 1, fur);
        px(8, 8, 1, 1, fur);
        px(4, 11, 8, 1, accent);
        const bob = frame % 2;
        ctx.fillStyle = accent;
        ctx.font = 'bold 9px monospace';
        ctx.fillText(bob === 0 ? 'z' : 'Z', 21, 12 - bob * 2);
        return;
      }

      // Perked ears with inner accent
      px(5, 3, 2, 2, fur);
      px(10, 3, 2, 2, fur);
      px(6, 4, 1, 1, accent);
      px(10, 4, 1, 1, accent);

      // Head & eyes (blinks when sitting, rosy cheeks & open mouth when meowing)
      px(5, 5, 7, 4, fur);
      const blinking = state === 'sit' && frame % 26 === 0;
      if (state === 'meow') {
        px(6, 6, 1, 1, eye);
        px(10, 6, 1, 1, eye);
        px(5, 7, 1, 1, accent);
        px(11, 7, 1, 1, accent);
        px(8, 8, 1, 1, eye);
      } else if (!blinking) {
        px(6, 6, 1, state === 'alert' ? 2 : 1, eye);
        px(10, 6, 1, state === 'alert' ? 2 : 1, eye);
      }
      px(8, 7, 1, 1, accent);

      // Accent collar
      px(5, 9, 6, 1, accent);

      // Body & stride paws
      px(3, 10, 8, 4, fur);
      const stride = state === 'run' ? (frame % 2 === 0 ? 1 : -1) : 0;
      px(4 + stride, 14, 2, 1, fur);
      px(9 - stride, 14, 2, 1, fur);

      // Tail flick
      const tailShift = state === 'run' || state === 'meow' || frame % 12 < 3 ? frame % 2 : 0;
      px(2, 9 - tailShift, 1, 3, fur);
      px(1, 8 - tailShift, 1, 2, accent);

      if (state === 'alert') {
        ctx.fillStyle = accent;
        ctx.font = 'bold 9px monospace';
        ctx.fillText('!', 15, 7);
      } else if (state === 'meow') {
        const hy = frame % 2 === 0 ? 1 : 0;
        px(12, hy, 1, 1, accent);
        px(14, hy, 1, 1, accent);
        px(12, hy + 1, 3, 1, accent);
        px(13, hy + 2, 1, 1, accent);
      }
    }

    function step(now: number) {
      if (!isActive() || document.hidden) {
        rafId = 0;
        return;
      }

      if (now - lastTick >= 100) {
        lastTick = now;
        frame++;

        const dx = targetX - x;
        const dy = targetY - y;
        const dist = Math.hypot(dx, dy);

        if (meowTicks > 0) {
          meowTicks--;
          idleTicks = 0;
          state = 'meow';
        } else if (dist > 32) {
          if (state === 'sleep') {
            alertTicks = 3;
          }
          idleTicks = 0;
          if (alertTicks > 0) {
            state = 'alert';
            alertTicks--;
          } else {
            state = 'run';
            if (Math.abs(dx) > 2) facing = dx > 0 ? 1 : -1;
            const move = Math.min(9, dist);
            const rawX = x + (dx / dist) * move;
            const rawY = y + (dy / dist) * move;
            x = Math.max(8, Math.min(window.innerWidth - 40, rawX));
            y = Math.max(8, Math.min(window.innerHeight - 40, rawY));
          }
        } else {
          idleTicks++;
          state = idleTicks > 28 ? 'sleep' : 'sit';
        }

        catCanvas!.style.left = `${Math.round(x)}px`;
        catCanvas!.style.top = `${Math.round(y)}px`;
        if (meowLabel) {
          const showMeow = state === 'meow' && isActive();
          meowLabel.classList.toggle('hidden', !showMeow);
          if (showMeow) {
            meowLabel.style.left = `${Math.round(Math.max(8, Math.min(window.innerWidth - 56, x - 4)))}px`;
            meowLabel.style.top = `${Math.round(Math.max(8, y - 16 - (frame % 2)))}px`;
          }
        }
        drawCat();
      }

      rafId = requestAnimationFrame(step);
    }

    function startLoop() {
      if (!rafId && isActive() && !document.hidden) {
        lastTick = performance.now();
        drawCat();
        rafId = requestAnimationFrame(step);
      }
    }

    window.addEventListener('pointermove', (e) => {
      if (!isActive()) return;
      targetX = e.clientX - 16;
      targetY = e.clientY - 16;
    }, { passive: true });

    window.addEventListener('pointerdown', (e) => {
      if (!isActive()) return;
      const nowMs = performance.now();
      if (state === 'meow' || nowMs - lastMeowAt < MEOW_COOLDOWN_MS) return;
      const target = e.target as Element | null;
      if (target?.closest('a, button, input, select, textarea, summary, [role="switch"]')) return;
      if (Math.hypot(e.clientX - (x + 16), e.clientY - (y + 16)) <= 30) {
        lastMeowAt = nowMs;
        meowTicks = 14;
        idleTicks = 0;
        state = 'meow';
        if (meowLabel) {
          meowLabel.classList.remove('hidden');
          meowLabel.style.left = `${Math.round(Math.max(8, Math.min(window.innerWidth - 56, x - 4)))}px`;
          meowLabel.style.top = `${Math.round(Math.max(8, y - 16))}px`;
        }
        drawCat();
        void playMeowSound();
      }
    }, { passive: true });

    toggleBtn.addEventListener('click', () => {
      disabled = !disabled;
      try {
        window.localStorage.setItem(STORAGE_KEY, String(disabled));
      } catch {
        // Ignore storage restriction errors in private browsing.
      }
      syncVisibility();
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        cancelAnimationFrame(rafId);
        rafId = 0;
      } else {
        startLoop();
      }
    });

    desktopQuery.addEventListener('change', syncVisibility);
    motionQuery.addEventListener('change', syncVisibility);
    new MutationObserver(() => {
      if (isActive()) drawCat();
    }).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });
    syncVisibility();
  }
</script>
